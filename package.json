{
  "name": "pi-tgrep",
  "version": "0.1.0",
  "description": "Microsoft tgrep integration for Pi with safe Git-aware lazy indexing and agent-friendly code search.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "tgrep",
    "grep",
    "code-search",
    "trigram",
    "microsoft"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck"
  },
  "pi": {
    "extensions": [
      "./extensions/tgrep.ts"
    ]
  },
  "dependencies": {
    "typebox": "1.3.27"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.85.1"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skyland-zero/pi-tgrep.git"
  },
  "bugs": {
    "url": "https://github.com/skyland-zero/pi-tgrep/issues"
  },
  "homepage": "https://github.com/skyland-zero/pi-tgrep#readme",
  "engines": {
    "node": ">=22.19.0"
  }
}
